{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musicmc-upload",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://yskeli.github.io",
    "GITHUB_REPOSITORY": "YSKeLi/MusicMC-Uploads",
    "GITHUB_BRANCH": "main"
  }
}
